# Clave de API de Telnyx (también puede venir exportada desde el shell, p. ej. ~/.zshenv)
TELNYX_API_KEY=

# Los completa `voice-outbound setup-assistant` (la TeXML App la crea Telnyx junto con el asistente)
TELNYX_ASSISTANT_ID=
TELNYX_TEXML_APP_ID=

# Número chileno de origen en E.164
TELNYX_FROM_NUMBER=+56XXXXXXXXX

# Opcional: account SID de TeXML. Si se deja vacío se obtiene con /v2/whoami
TELNYX_ACCOUNT_SID=

# Modelos
TELNYX_ASSISTANT_MODEL=moonshotai/Kimi-K2.6
TELNYX_ASSISTANT_VOICE=Azure.es-CL-CatalinaNeural
# Solo para voces de proveedores externos (p. ej. ElevenLabs): nombre del secreto en Telnyx
TELNYX_ASSISTANT_VOICE_API_KEY_REF=
TELNYX_EXTRACTION_MODEL=zai-org/GLM-5.3-Flash

# Campaña
MAX_DURACION_SEG=600
PAUSA_ENTRE_LLAMADAS_SEG=5
CIUDAD_DEFAULT=Santiago
